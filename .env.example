# ==============================================================
# 이 파일을 복사해서 ".env" 로 저장한 후 실제 값을 채워 넣으세요.
# ".env" 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 포함되어 있음).
# ==============================================================

# ---------------- 공통 설정 ----------------
HOMEPAGE_URL=https://www.kstudy101.jp/

# LINE 친구추가 링크. X 본문에는 넣지 않는다(URL 과금 회피). 프로필/고정글용.
# 아래 LINE Messaging API(ENABLE_LINE)와는 별개입니다.
LINE_ADD_URL=https://lin.ee/8Rz047O

DATA_FILE=data/phrases.json
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
POST_INTERVAL_HOURS=12

# ---------------- 사용할 SNS 플랫폼 on/off (true/false) ----------------
ENABLE_TWITTER=true
ENABLE_THREADS=false
ENABLE_LINE=false

# ---------------- X (Twitter) API v2 ----------------
# https://developer.twitter.com 에서 앱 생성 후 발급
# "Read and Write" 권한으로 설정해야 create_tweet이 동작합니다.
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ---------------- Threads API ----------------
# https://developers.facebook.com/docs/threads 참고
# Meta 개발자 앱에 Threads API 사용 사례를 추가하고 장기 액세스 토큰을 발급받으세요.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ---------------- LINE Messaging API (확장/선택사항) ----------------
# https://developers.line.biz 에서 채널 생성 후 발급
LINE_CHANNEL_ACCESS_TOKEN=
